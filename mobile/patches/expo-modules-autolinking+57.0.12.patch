+# macOS still ships Ruby 2.6 on some supported development machines. Expo's
+# precompiled module discovery uses Array#filter_map, introduced in Ruby 2.7.
+unless [].respond_to?(:filter_map)
+  class Array
+    def filter_map
+      return enum_for(:filter_map) unless block_given?
+
+      each_with_object([]) do |item, values|
+        value = yield(item)
+        values << value if value
+      end
+    end
+  end
+end
