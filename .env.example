SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Recommandé : JWK privée ES256 importée dans Supabase, sérialisée sur une ligne.
SUPABASE_SIGNING_PRIVATE_JWK=
# Repli transitoire uniquement si le projet utilise encore le secret JWT historique.
# SUPABASE_JWT_SECRET=
SUPABASE_POSTGRES_URL_NON_POOLING=
# SUPABASE_POSTGRES_URL= peut servir de repli si l'URL directe n'est pas disponible.
SUPABASE_TROPHY_IMAGES_BUCKET=trophy-images
SUPABASE_AUTH_REDIRECT_TO=https://monjournaldebloc.fr/
PROJECT1_BACKUP_DIR=
PROJECT1_BACKUP_RETENTION_DAYS=30
# Dossier contenant bin/pg_dump, bin/pg_restore et bin/psql (facultatif sur le Mac configuré).
PROJECT1_POSTGRES_DIRECTORY=
# Réservé à un projet isolé et jetable ; ne jamais définir sur la production.
# PROJECT1_RESTORE_DRILL=1
VITE_SUPPORT_EMAIL=contact@monjournaldebloc.fr

